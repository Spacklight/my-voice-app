{
    "name": "my-voice-app",
    "main": "worker/index.ts",
    "compatibility_date": "2026-08-27",
    "assets": {
        "directory": "dist",
        "not_found_handling": "single-page-application"
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "ROOM_DO",
                "class_name": "RoomDO"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["RoomDO"]
        }
    ],
    "observability": {
        "enabled": true
    }
}
